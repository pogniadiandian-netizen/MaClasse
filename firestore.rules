rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isEmailVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'kankanjakankanja@gmail.com')
      );
    }

    function isOwnReportId(reportId) {
      return reportId.matches('^prim_(debut|fin)_[a-zA-Z0-9_\\-]+_' + request.auth.uid + '$');
    }

    function isValidPoste(poste) {
      return poste is string && poste in ['directeur', 'titulaire', 'suppleant', 'gestionnaire'];
    }

    function isValidUserProfile(data, expectedUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'poste', 'classeAssignee', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'poste', 'classeAssignee', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == expectedUid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && isValidPoste(data.poste)
        && data.classeAssignee is string
        && data.classeAssignee.size() >= 1
        && data.classeAssignee.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStatisticalReport(data) {
      return data.keys().hasAll(['ownerId', 'reportKind', 'anneeScolaire', 'ecole', 'payload', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'reportKind', 'anneeScolaire', 'ecole', 'payload', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.reportKind is string
        && data.reportKind in ['prim_debut', 'prim_fin']
        && data.anneeScolaire is string
        && data.anneeScolaire.size() >= 4
        && data.anneeScolaire.size() <= 20
        && data.ecole is string
        && data.ecole.size() <= 120
        && data.payload is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminUid} {
      allow get: if isEmailVerified() && isValidId(adminUid) && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming(), existing().uid)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'poste', 'classeAssignee', 'updatedAt']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId)
        && isEmailVerified()
        && (
          (resource == null && isOwnReportId(reportId))
          || (resource != null && (existing().ownerId == request.auth.uid || isAdmin()))
          || isAdmin()
        );
      allow list: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(reportId)
        && isEmailVerified()
        && isValidStatisticalReport(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(reportId)
        && isEmailVerified()
        && (existing().ownerId == request.auth.uid || isAdmin())
        && isValidStatisticalReport(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().reportKind == existing().reportKind
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['anneeScolaire', 'ecole', 'payload', 'updatedAt']);
      allow delete: if isValidId(reportId) && isEmailVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
